# Copy to `.env.local` and adjust. Every value here reaches the browser, so
# nothing secret belongs in this file.

# Base URL of the auth API, without a trailing slash.
#
# Only authentication talks to a server: sign-up, sign-in and the `me/auth`
# check. Every analysis in the panel runs in the browser, and its results are
# stored in localStorage — see docs/ARCHITECTURE.md.
NEXT_PUBLIC_API_URL=https://helix-core-backend.onrender.com/api/v1

# Local testing switch: set to "1" to start already signed in.
#
# Everything in the panel lives behind the auth gate, so without a reachable
# backend and real credentials none of it can be opened. This seeds a local
# session instead. It changes only the *initial* session — sign-in, sign-up and
# sign-out keep working — and anything other than "1" leaves auth alone.
#
# A production build ignores it regardless of what is set here: the check is
# `NODE_ENV !== "production"` as well as this flag, because `next build` reads
# `.env.local` too and a local production build would otherwise ship unlocked.
NEXT_PUBLIC_DISABLE_AUTH=0

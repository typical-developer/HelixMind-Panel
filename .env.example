# Copy to `.env.local` and adjust. Anything prefixed `NEXT_PUBLIC_` reaches the
# browser, so nothing secret belongs behind that prefix.

# Where the auth API really lives. Server-side only — the browser never sees it.
#
# `next.config.mjs` rewrites /api/backend/* to this, so the panel calls its own
# origin and the request reaches the backend from the server. Only set this to
# point at a different backend (a local one, or staging).
API_UPSTREAM=https://helix-core-backend.onrender.com/api/v1

# Override the base the BROWSER calls. Leave this UNSET in any deployment.
#
# Unset, the panel calls `/api/backend` on its own origin and the rewrite above
# does the rest. Setting it to the backend's own host makes the browser call
# that host directly — which only works from an origin on the backend's CORS
# allowlist. That allowlist currently holds `http://localhost:3000` and nothing
# else, so a deployed panel configured this way cannot sign in: the preflight
# returns 500 with no Access-Control-Allow-Origin and the browser blocks the
# request before it leaves. The panel reports that as "Could not reach the
# server", which is true but misleading.
#
# Worth remembering: NEXT_PUBLIC_* values are inlined at BUILD time, so changing
# this in a hosting dashboard does nothing until you redeploy.
#
# Only authentication talks to a server: sign-up, sign-in and the `me/auth`
# check. Every analysis in the panel runs in the browser, and its results are
# stored in localStorage — see docs/ARCHITECTURE.md.
# NEXT_PUBLIC_API_URL=

# Local testing switch: set to "1" to start already signed in.
#
# Everything in the panel lives behind the auth gate, so without a reachable
# backend and real credentials none of it can be opened. This seeds a local
# session instead. It changes only the *initial* session — sign-in, sign-up and
# sign-out keep working — and anything other than "1" leaves auth alone.
#
# A production build ignores it regardless of what is set here: the check is
# `NODE_ENV !== "production"` as well as this flag, because `next build` reads
# `.env.local` too and a local production build would otherwise ship unlocked.
NEXT_PUBLIC_DISABLE_AUTH=0
